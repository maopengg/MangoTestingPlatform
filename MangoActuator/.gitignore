# Created by .gitignore support plugin (hsz.mobi)
.idea/
.venv/
venv/
build/
dist/

# Python 缓存
*.pyc
*.py[cod]
__pycache__/
**/__pycache__/

# 日志
*.log
logs\\*.log

# 运行时目录，所有新生成的缓存、截图、视频、下载、上传都应进入 runtime
runtime/

# 历史运行时目录，保留忽略规则避免旧环境再次生成后进入 Git
logs/
cache/
screenshot/
upload/
videos/
download/
mango_pytest/
allure/
browser_cache/

# 测试、构建和打包产物
tests/*.json
*.spec
main.build/
main.dist/
nuitka-crash-report.xml
.DS_Store
**/.DS_Store
