# 部署配置：修改本文件后运行 sh deploy.sh，Compose / K8s 共用。
# 值含 #、$ 或空格时使用单引号包裹；填写真实凭据后不要提交本文件。

# ── 1. MySQL 数据库 · 按连接方式填写 ──────────────────────────
# internal：启动内置 MySQL；密码留空时首次自动生成，已有数据库保留原密码。
# external：连接已有 MySQL；必填：地址、端口、库名、用户名、原密码。
# settings：使用 DJANGO_ENV 对应的 dev.py / test.py / master.py，下面 MYSQL_* 不覆盖其连接配置。
MYSQL_MODE=internal  # 可选：internal / external / settings
MYSQL_HOST=db  # external 必填：数据库 IP 或域名；internal 固定使用 db
MYSQL_PORT=3306  # external 必填：数据库端口，通常为 3306；internal 固定使用 3306
MYSQL_DATABASE=mango_server  # internal/external 必填：平台使用的数据库名称
MYSQL_USER=mango  # internal/external 必填：数据库用户名；internal 不使用 root
# external 必填：数据库用户的原密码；internal 首次留空自动生成，后续留空沿用。
MYSQL_PASSWORD=
# internal 可选：MySQL root 密码；首次留空自动生成，后续留空沿用。
MYSQL_ROOT_PASSWORD=
MYSQL_BINLOG=false  # 可选：true / false；是否开启内置 MySQL 二进制日志
MYSQL_BUFFER_POOL_SIZE=256M  # 可选：内置 MySQL 缓冲池大小，单位如 M / G
MYSQL_MAX_CONNECTIONS=100  # 可选：内置 MySQL 最大连接数，正整数
MYSQL_EXPOSE_BIND=127.0.0.1  # 可选：内置 MySQL 对外端口的监听地址；0.0.0.0 允许外部访问
# 可选：内置 MySQL 的宿主机端口；留空不暴露，填写后可供数据库客户端连接。
MYSQL_EXPOSE_PORT=

# ── 2. 文件存储 · 按类型填写 ──────────────────────────────────
# local：保存在部署数据目录下的 server_runtime/media，下面 MinIO / S3 参数不用填。
# minio：保存在 MinIO；internal 启动内置服务，external 连接已有服务。
#        external 必填：S3_ENDPOINT、S3_BUCKET、S3_ACCESS_KEY、S3_SECRET_KEY、S3_PUBLIC_BASE_URL。
# tos：保存在火山云 TOS；必填：S3_ENDPOINT、S3_REGION、S3_BUCKET、
#      S3_ACCESS_KEY、S3_SECRET_KEY、S3_PUBLIC_BASE_URL；桶需提前创建。
FILE_STORAGE_BACKEND=local  # 可选：local / minio / tos
MINIO_MODE=internal  # minio 可选：internal / external；tos 不使用此项
# 外部 MinIO / TOS 必填：S3 兼容服务地址，不含桶名，例如 storage.example.com:9000。
S3_ENDPOINT=
# TOS 必填：区域，例如 cn-beijing；MinIO 可选，留空自动发现。
S3_REGION=
S3_BUCKET=mango-file  # minio/tos 必填：文件桶名称；内置 MinIO 默认自动创建
# 外部 MinIO / TOS 必填：访问密钥 ID；内置 MinIO 留空使用内置账号。
S3_ACCESS_KEY=
# 外部 MinIO / TOS 必填：访问密钥密码；内置 MinIO 首次留空自动生成，后续沿用。
S3_SECRET_KEY=
# 外部 MinIO / TOS 必填：浏览器可访问的桶地址，例如 https://files.example.com/mango-file。
# 内置 MinIO 可选：留空使用 PUBLIC_URL/minio/桶名。
S3_PUBLIC_BASE_URL=
S3_USE_HTTPS=true  # 可选：true / false；访问存储是否使用 HTTPS；内置 MinIO 固定使用 HTTP
S3_PRESIGNED=true  # 可选：true / false；是否使用临时签名链接下载私有桶文件
# 可选：true / false；是否自动创建桶；留空时 MinIO 为 true，TOS 为 false。
S3_AUTO_CREATE_BUCKET=
# 可选：true / false；是否使用“桶名.服务域名”访问；留空时 TOS 为 true，MinIO 为 false。
S3_VIRTUAL_HOST_STYLE=
MINIO_CONSOLE_BIND=127.0.0.1  # 可选：内置 MinIO 控制台的宿主机监听地址
# 可选：内置 MinIO 控制台的宿主机端口；留空不暴露。
MINIO_CONSOLE_PORT=

# ── 3. 平台访问与代理 ─────────────────────────────────────────
PUBLIC_URL=http://localhost:8000  # 必填：用户访问平台的完整地址，包含协议；远程访问改为服务器 IP 或域名
WEB_BIND=0.0.0.0  # Compose 可选：网页入口监听地址；0.0.0.0 允许外部访问
WEB_PORT=8000  # Compose 必填：网页入口宿主机端口，范围 1～65535
# Compose 可选：额外 API 入口的宿主机端口；留空与网页共用入口，不可与 WEB_PORT 相同。
API_PORT=
FRONTEND_API_BASE=/api  # 可选：浏览器 API 地址；同源使用 /api，跨域填写 https://api.example.com/api
# 可选：浏览器实时连接地址，例如 wss://api.example.com/ws/web/socket?；留空从 API / PUBLIC_URL 推导。
FRONTEND_SOCKET_URL=
BACKEND_UPSTREAM=http://mango_server:8000  # 必填：网关连接后端的地址；默认指向部署内的 Server
# 可选：允许跨域访问的前端来源，包含协议和端口，英文逗号分隔；留空使用 PUBLIC_URL。
CORS_ALLOWED_ORIGINS=
# 可选：独立 API / MCP 的公开地址，包含协议；留空从 FRONTEND_API_BASE / PUBLIC_URL 推导。
API_PUBLIC_URL=
EXTRA_HTTP_ROUTES={}  # 可选：额外代理路由 JSON，例如 {"/help/":"http://help.example.com"}；不自动添加认证

# ── 4. 服务进程与日志 ─────────────────────────────────────────
API_WORKER_COUNT=1  # 可选：API Worker 实例数量，范围 1～8
API_THREAD_POOL_SIZE=2  # 可选：每个 API Worker 的执行线程数，正整数
UVICORN_WORKERS=1  # 可选：Server 的 Uvicorn 进程数，正整数
MONITORING_ENABLED=false  # 可选：true / false；是否启动独立监控服务
LOG_MAX_SIZE=10m  # 可选：每份 Docker 容器日志的轮转大小，单位 k / m / g
LOG_MAX_FILE=1  # 可选：每个容器保留的日志文件数，正整数

# ── 5. 部署环境与镜像 ─────────────────────────────────────────
DEPLOY_TARGET=compose  # 可选：compose / k8s
COMPOSE_PROJECT_NAME=mango  # Compose 可选：项目名称，用于区分容器、网络和数据卷
DJANGO_ENV=master  # 可选：dev / test / master / prod；prod 对应 master；dev 调度器仅执行系统清理
VUE_ENV=master  # 可选：dev / test / master；前端构建环境
SERVER_IMAGE=mango-server:single  # 必填：后端镜像名称与标签；K8s 使用集群可拉取或已导入的镜像
CONSOLE_IMAGE=mango-console:single  # 必填：前端镜像名称与标签；K8s 使用集群可拉取或已导入的镜像
MYSQL_IMAGE=mysql:8.0.40-debian  # internal MySQL 可选：数据库镜像
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z  # internal MinIO 可选：文件服务镜像
NGINX_IMAGE=nginx:1.27-alpine  # Compose 可选：入口网关镜像
PYTHON_IMAGE=python:3.10.19-slim-bookworm  # 可选：构建后端使用的 Python 基础镜像
NODE_IMAGE=node:20.20.1  # 可选：构建前端使用的 Node.js 基础镜像
MANGO_DATA_DIR=/mango_data  # 必填：部署数据的宿主机绝对目录，保存数据库、附件、运行日志和备份
NODE_HEAP_MB=auto  # 可选：auto / 512～65536 的整数 MB；auto 使用 6144MB Node 堆，另需至少 1536MB 堆外内存
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple  # 可选：构建后端时使用的 Python 包下载源
NPM_REGISTRY=https://registry.npmmirror.com  # 可选：构建前端时使用的 npm 包下载源

# ── 6. 平台密钥与初始账号 · 可选 ───────────────────────────────
# 留空时首次自动生成，后续保留 .env 中的原值；已有密钥不要重新生成。
# 可选：平台签名与加密密钥；更换会影响已有凭据和加密数据。
DJANGO_SECRET_KEY=
# 可选：UI 直播访问签名密钥。
LIVE_STREAM_SIGNING_KEY=
# 可选：首次创建管理员账号的密码；修改此项不会重置已有账号密码。
MANGO_INITIAL_ADMIN_PASSWORD=
# 可选：首次创建游客账号的密码；修改此项不会重置已有账号密码。
MANGO_INITIAL_GUEST_PASSWORD=

# ── 7. 执行器 · 按需启用 ──────────────────────────────────────
# 已有独立执行器时保持关闭；启用后填写执行器连接地址、登录账号和密码。
ACTUATOR_ENABLED=false  # 可选：true / false；是否部署执行器
ACTUATOR_IMAGE=mango-actuator:single  # 启用时必填：执行器镜像名称与标签
ACTUATOR_HOST=http://mango-gateway  # 启用时必填：执行器访问平台的地址，包含协议
ACTUATOR_USERNAME=open  # 启用时必填：执行器登录账号
# 启用时必填：执行器登录密码。
ACTUATOR_PASSWORD=
ACTUATOR_PROFILE=standard  # 可选：执行器能力预设名称，默认 standard
ACTUATOR_CAPABILITIES=web_ui,pytest  # 可选：启用的执行能力，英文逗号分隔；web_ui 为网页自动化，pytest 为 Pytest
ACTUATOR_WEB_PARALLEL=1  # 可选：网页自动化并行数，正整数
ACTUATOR_PYTEST_PARALLEL=2  # 可选：Pytest 并行数，正整数
ACTUATOR_QUEUE_SIZE=2  # 可选：执行器等待队列容量，正整数

# ── 8. Kubernetes · DEPLOY_TARGET=k8s 时使用 ────────────────────
K8S_NAMESPACE=mango  # 必填：部署的命名空间
K8S_IMAGE_PULL_POLICY=IfNotPresent  # 可选：Always / IfNotPresent / Never；镜像拉取策略
# 可选：镜像仓库认证 Secret 名称；留空不指定认证 Secret。
K8S_IMAGE_PULL_SECRET=
# 可选：持久卷 StorageClass 名称；留空使用集群默认值。
K8S_STORAGE_CLASS=
K8S_RUNTIME_STORAGE_SIZE=10Gi  # 可选：后端共享运行目录的持久卷容量
K8S_RUNTIME_ACCESS_MODE=ReadWriteMany  # 可选：ReadWriteMany / ReadWriteOnce；运行目录持久卷访问模式，须由存储支持
K8S_MYSQL_STORAGE_SIZE=10Gi  # internal MySQL 可选：数据库持久卷容量
K8S_MINIO_STORAGE_SIZE=10Gi  # internal MinIO 可选：文件服务持久卷容量
K8S_SERVICE_TYPE=ClusterIP  # 可选：ClusterIP / NodePort / LoadBalancer；平台入口 Service 类型
K8S_NODE_PORT=30080  # NodePort 可选：节点端口，范围 30000～32767
# 可选：平台 Ingress 域名，不带协议；留空不创建 Ingress。
K8S_INGRESS_HOST=
# 可选：IngressClass 名称；留空使用控制器默认值。
K8S_INGRESS_CLASS=
# 可选：Ingress HTTPS 证书 Secret 名称；留空不配置 TLS 证书。
K8S_TLS_SECRET=
K8S_DNS_RESOLVER=kube-dns.kube-system.svc.cluster.local  # 可选：网关解析集群服务名称使用的 DNS 地址
K8S_WAIT_TIMEOUT=300s  # 可选：K8s 任务完成及服务就绪的等待时间，正整数秒加 s，例如 300s / 600s
