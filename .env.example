# 唯一部署配置入口：首次 sh deploy.sh 自动生成 .env；只修改 .env 后重新部署。
# 本文件可提交；真实 .env 含凭据，不要提交。值中的 #、$、空格建议用单引号包裹。
# internal/external 的已有数据库须沿用原密码；更改此文件不会修改数据库中的用户密码。
# MYSQL_MODE 选择数据库的部署方式和配置来源，不是运行环境名称：
# internal：随平台启动 MySQL；使用下面的库名、业务账号/密码和 root 密码，连接固定为 db:3306。
# external：连接已有 MySQL；填写下面的 HOST/PORT/DATABASE/USER/PASSWORD，不启动内置数据库。
# settings：沿用 DJANGO_ENV 所选的 dev.py/test.py/master.py 中的数据库配置，不启动内置数据库。
#           此模式忽略下方 MYSQL_* 连接参数，不改写 Python 文件，也不把其中密码复制到 .env。
# 新部署且没有数据库选 internal；已有独立 MySQL 选 external；沿用公司 Python 配置选 settings。
MYSQL_MODE=internal
# external 时填写容器可访问的数据库地址；internal 固定 db:3306；settings 从所选 Python 文件读取。
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=mango_server
MYSQL_USER=mango
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# local / minio / tos
FILE_STORAGE_BACKEND=local
# minio 时可选 internal / external
MINIO_MODE=internal
# 外部 MinIO/TOS 使用 S3 兼容地址（主机:端口，不含桶名）
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=mango-file
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 浏览器可访问的完整桶地址，如 https://files.example.com/mango-file
# 内置 MinIO 留空时自动使用 PUBLIC_URL/minio/桶名。
S3_PUBLIC_BASE_URL=
S3_USE_HTTPS=true
S3_PRESIGNED=true
S3_AUTO_CREATE_BUCKET=
S3_VIRTUAL_HOST_STYLE=
# TOS 通常使用 S3_REGION=cn-beijing、S3_VIRTUAL_HOST_STYLE=true。
# TOS 桶由云控制台预建；不需要在平台开放创建桶权限。

PUBLIC_URL=http://localhost:8000
WEB_BIND=0.0.0.0
WEB_PORT=8000
# 可选额外 API 入口，如 8000；前端 WEB_PORT 可设 8001；同源只需留空。
API_PORT=
# 浏览器请求 /api 为同源；也可填写 https://api.example.com/api。
FRONTEND_API_BASE=/api
# 留空自动从 API / PUBLIC_URL 推导，跨域代理部署可显式配置 wss://api.example.com/ws/web/socket?
FRONTEND_SOCKET_URL=
# Nginx 访问后端的地址；后端在其他机器时填写 http://其他机器:8000。
BACKEND_UPSTREAM=http://mango_server:8000
# 逗号分隔允许的前端来源（含协议和端口）；留空默认 PUBLIC_URL。
CORS_ALLOWED_ORIGINS=

MANGO_DATA_DIR=/mango_data
NODE_HEAP_MB=2560
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
# 以下密钥首次部署自动生成；备份 .env，已有数据库不要重新生成。
DJANGO_SECRET_KEY=
LIVE_STREAM_SIGNING_KEY=
MANGO_INITIAL_ADMIN_PASSWORD=
MANGO_INITIAL_GUEST_PASSWORD=

# 部署目标：compose / k8s。两种部署读取同一个 .env。
DEPLOY_TARGET=compose
COMPOSE_PROJECT_NAME=mango
DJANGO_ENV=master
VUE_ENV=master
SERVER_IMAGE=mango-server:single
CONSOLE_IMAGE=mango-console:single
MYSQL_IMAGE=mysql:8.0.40-debian
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
NGINX_IMAGE=nginx:1.27-alpine
PYTHON_IMAGE=python:3.10.19-slim-bookworm
NODE_IMAGE=node:20.20.1
# 数据库二进制日志默认关闭；启用后需另行管理保留与备份。
MYSQL_BINLOG=false
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=100
# 留空不暴露数据库；已有 DBX 连接可填写原绑定地址和端口。
MYSQL_EXPOSE_BIND=127.0.0.1
MYSQL_EXPOSE_PORT=
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=
LOG_MAX_SIZE=10m
LOG_MAX_FILE=1
API_THREAD_POOL_SIZE=2
UVICORN_WORKERS=1
MONITORING_ENABLED=false
# 额外静态站点路由，例如 {"/help/":"http://help-site:80"}；不自动添加认证。
EXTRA_HTTP_ROUTES={}
# 可选公开 API 地址，用于独立 API/MCP 入口的来源校验。
API_PUBLIC_URL=

# 可选执行器；默认不启动，保留现有独立执行器部署。
ACTUATOR_ENABLED=false
ACTUATOR_IMAGE=mango-actuator:single
ACTUATOR_HOST=http://mango-gateway
ACTUATOR_USERNAME=open
ACTUATOR_PASSWORD=
ACTUATOR_PROFILE=standard
ACTUATOR_CAPABILITIES=web_ui,pytest
ACTUATOR_WEB_PARALLEL=1
ACTUATOR_PYTEST_PARALLEL=2
ACTUATOR_QUEUE_SIZE=2

# K8s：镜像必须已推送至集群可访问的仓库，或预先导入每个节点。
K8S_NAMESPACE=mango
K8S_IMAGE_PULL_POLICY=IfNotPresent
K8S_IMAGE_PULL_SECRET=
K8S_STORAGE_CLASS=
K8S_RUNTIME_STORAGE_SIZE=10Gi
K8S_RUNTIME_ACCESS_MODE=ReadWriteMany
K8S_MYSQL_STORAGE_SIZE=10Gi
K8S_MINIO_STORAGE_SIZE=10Gi
K8S_SERVICE_TYPE=ClusterIP
K8S_NODE_PORT=30080
K8S_INGRESS_HOST=
K8S_INGRESS_CLASS=
K8S_TLS_SECRET=
K8S_DNS_RESOLVER=kube-dns.kube-system.svc.cluster.local
K8S_WAIT_TIMEOUT=300s
# API Worker 容器/Pod 数量（1-8）；线程并发由 API_THREAD_POOL_SIZE 控制。
API_WORKER_COUNT=1
