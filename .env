# =========================
# MySQL 配置
# =========================
# docker-compose demo 会启动一个 MySQL 容器。
# MYSQL_ROOT_PASSWORD 是 root 密码；MYSQL_USER/MYSQL_PASSWORD 是业务账号。
# 如果要连接外部数据库，需要同步修改 MangoServer/src/settings/{dev,test,master}.py 中的 MYSQL_*。
MYSQL_ROOT_PASSWORD=mP123456&
MYSQL_DATABASE=mango_server
MYSQL_USER=user
MYSQL_PASSWORD=mP123456&
MYSQL_PORT=3306

# =========================
# 文件存储 / MinIO 配置
# =========================
# FILE_STORAGE_BACKEND 支持 local/minio/tos：
#   local：后端本地文件，适合开发环境。
#   minio：docker-compose demo 默认对象存储。
#   tos：火山 TOS，需要在后端 settings/test.py 或环境变量中配置 TOS endpoint 与 AK/SK。
# MINIO_PUBLIC_BASE_URL 是返回给前端的下载地址前缀；demo 通过 nginx /minio 转发到 MinIO。
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=mP123456
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
FILE_STORAGE_BACKEND=minio
MINIO_PUBLIC_BASE_URL=/minio/mango-file

# =========================
# Django / Vue / 执行器
# =========================
# DJANGO_ENV 选择后端配置文件：dev/test/master。
# VUE_ENV 选择前端 .env 文件：dev/test/master。
# EXECUTOR_TYPE 选择执行器类型：pytest / pytest_web / web_ui / android_ui；留空表示不启用执行器。
DJANGO_ENV=master
VUE_ENV=master
EXECUTOR_TYPE=pytest_web
