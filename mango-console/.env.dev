BUILD_PATH=/
VITE_APP_ENV='dev'
# dev 用于本地前端开发：npm run dev 默认启动 Vite，后端请单独启动在 127.0.0.1:8000。
# VITE_APP_BASE_URL 必须指向后端 API 根路径，注意末尾包含 /api。
VITE_APP_BASE_URL = 'http://127.0.0.1:8000/api'
# WebSocket 地址用于页面实时日志和执行器连接状态。
VITE_APP_SOCKET_URL = 'ws://127.0.0.1:8000/api/web/socket?'
# 本地 dev 如使用后端本地文件存储，此配置通常不会用到；如使用 docker MinIO，可改为 http://127.0.0.1:8000/minio。
VITE_APP_MINIO_URL = 'http://127.0.0.1:8000/minio'
# MCP 客户端展示用的服务名。
VITE_APP_MCP_SERVER_NAME = 'mango-test-platform'
# 是否开启首页弹窗，true 开启，false 关闭。
VITE_IS_INDEX_WINDOW = 'false'