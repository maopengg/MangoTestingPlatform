BUILD_PATH=/
VITE_APP_ENV='test'
# test 用于公司测试环境或自建测试环境。
# 如果前端和后端同域部署，保持 /api；如果跨域部署，改成完整后端地址，例如 https://auto.example.com/api。
VITE_APP_BASE_URL = '/api'
# 留空时前端会根据当前页面地址自动生成 ws(s)://当前域名/api/web/socket?。
VITE_APP_SOCKET_URL = ''
# 对象存储外部访问前缀。公司 TOS/CDN 场景可改为完整公网地址；同域网关代理可保持 /minio。
VITE_APP_MINIO_URL = '/minio'
