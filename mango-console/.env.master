BUILD_PATH=/
VITE_APP_ENV='master'
# master 用于默认 docker-compose/开源 demo 部署。
# 前端、API、MCP 统一通过同一个域名端口访问，因此 API 根路径使用相对路径 /api。
VITE_APP_BASE_URL = '/api'
# 留空时前端会根据当前页面地址自动生成 ws(s)://当前域名/api/web/socket?。
VITE_APP_SOCKET_URL = ''
# MinIO 外部访问前缀。docker-compose 默认由 nginx 将 /minio 转发到 minio:9000。
VITE_APP_MINIO_URL = '/minio'
